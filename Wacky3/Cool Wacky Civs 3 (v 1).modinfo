  <EntryPoints>
    <EntryPoint type="InGameUIAddin" file="TheMinistryOfAlmost/Lua/CWC3_Almost.xml">
      <Name>Always the Challenger</Name>
      <Description>Ministry owner-turn snapshots and Second Wind defensive veterans.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="TheHollowChoir/Lua/CWC3_Choir.xml">
      <Name>Songs Beneath Stone</Name>
      <Description>Hollow Choir terrain yields and capture cleanup.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="TheSeventeenthSummer/Lua/CWC3_Summer.xml">
      <Name>The Great Emergence</Name>
      <Description>Save-backed Summer cycle, brood veterans and Nursery yields.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="ThePerpetualTimetable/Lua/CWC3_Timetable.xml">
      <Name>The Grand Schedule</Name>
      <Description>Ordinary Capital connections and continuous owned railway city yields.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="TheCandlekeepersCovenant/Lua/CWC3_Covenant.xml">
      <Name>The Names We Carry</Name>
      <Description>Save-backed permanent city destruction ledger, memory yields and Eternal Vigil.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="ThePaleontologicalDirectorate/Lua/PALEO_Gameplay.xml">
      <Name>The Earth Remembers</Name>
      <Description>Library/University class yields and save-backed successful excavation rewards.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="TheDepartmentOfLostThings/Lua/LOST_Gameplay.xml">
      <Name>Nothing Is Ever Truly Lost</Name>
      <Description>Save-backed per-city Curios from resolved enemy combat kills.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="TheAssemblyOfScarecrows/Lua/SCARECROW_Gameplay.xml">
      <Name>The Fields Have Eyes</Name>
      <Description>Owned unpillaged Farm thresholds and Harvest Bell yields.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="TheKingdomOfMakuria/Lua/MAKURIA_Gameplay.xml">
      <Name>The Walls of Dongola</Name>
      <Description>Per-city Walls BuildingClass Culture and Faith.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="TheSaltRoadCompact/Lua/SALT_Gameplay.xml">
      <Name>The Price of Passage</Name>
      <Description>Binary outgoing active land-route city yields.</Description>
    </EntryPoint>
  </EntryPoints>
</Mod>